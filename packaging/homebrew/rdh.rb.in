class Rdh < Formula
  desc "Portable R environment for database work"
  homepage "https://github.com/cole-brokamp/rdh"
  version "@VERSION@"
  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/cole-brokamp/rdh/releases/download/v@VERSION@/rdh-aarch64-apple-darwin.tar.gz"
      sha256 "@MACOS_ARM_SHA256@"
    else
      url "https://github.com/cole-brokamp/rdh/releases/download/v@VERSION@/rdh-x86_64-apple-darwin.tar.gz"
      sha256 "@MACOS_INTEL_SHA256@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/cole-brokamp/rdh/releases/download/v@VERSION@/rdh-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@LINUX_ARM_SHA256@"
    else
      url "https://github.com/cole-brokamp/rdh/releases/download/v@VERSION@/rdh-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@LINUX_INTEL_SHA256@"
    end
  end

  def install
    bin.install "rdh"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rdh version")
  end
end
