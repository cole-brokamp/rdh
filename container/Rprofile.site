local({
  image_config <- readRDS("/opt/rdh/image-config.rds")

  options(
    repos = c(CRAN = image_config$ppm_repo),
    HTTPUserAgent = sprintf(
      "R/%s R (%s)",
      getRversion(),
      paste(
        getRversion(),
        R.version[["platform"]],
        R.version[["arch"]],
        R.version[["os"]]
      )
    )
  )

  r_minor <- strsplit(R.version[["minor"]], ".", fixed = TRUE)[[1L]][1L]
  r_major_minor <- paste(R.version[["major"]], r_minor, sep = ".")
  data_root <- Sys.getenv(
    "RDH_DATA_DIR",
    unset = path.expand("~/.local/share/rdh")
  )
  user_library <- file.path(
    data_root,
    "v1",
    paste0("R-", r_major_minor),
    "library"
  )

  if (!dir.exists(user_library)) {
    dir.create(user_library, recursive = TRUE, showWarnings = FALSE)
  }

  if (!dir.exists(user_library)) {
    stop("rdh could not create its user library: ", user_library)
  }

  if (file.access(user_library, mode = 2L) != 0L) {
    stop("rdh user library is not writable: ", user_library)
  }

  Sys.setenv(R_LIBS_USER = user_library)
  .libPaths(unique(c(user_library, .libPaths())))
})

sys.source("/opt/rdh/database.R", envir = globalenv())
